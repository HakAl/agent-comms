#!/bin/sh
# Pre-push gate: hygiene and lint must pass before anything goes public.
#
# Git runs this with the remote name and URL as arguments and one line per
# ref on stdin: <local ref> <local sha> <remote ref> <remote sha>. For every
# branch being pushed, the commit range the push would publish is
# <remote sha>..<local sha>, so the hygiene scan gets GATES_BASE=<remote sha>
# when that commit is known here (a new branch, or a remote ahead of the
# checkout, falls back to hygiene's default base: origin/main, then main).
#
# The gates scan the working tree and HEAD, so the pushed branch must be the
# checked-out one; pushing another branch is refused with an explanation
# rather than scanned wrongly. Deletions and tags are not scanned. The test
# suite and the fresh-clone preverify stay out of this hook for speed; `make
# gate` remains the full check.
#
# Installed by `make hooks` as .git/hooks/pre-push. Bypass, when you must,
# with `git push --no-verify`.
set -u
cd "$(git rev-parse --show-toplevel)" || exit 2

remote=${1:-origin}
zero=0000000000000000000000000000000000000000
head=$(git rev-parse HEAD 2>/dev/null) || exit 2
head_branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || echo "detached HEAD")

status=0
scanned=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "${local_ref:-}" ] || continue
  case "$local_sha" in "$zero") continue ;; esac   # deletion
  case "$remote_ref" in refs/heads/*) ;; *) continue ;; esac   # tags, notes
  if [ "$local_sha" != "$head" ]; then
    echo "FAIL pre-push: $local_ref ($(git rev-parse --short "$local_sha")) is not the checked-out HEAD ($head_branch);" \
      "the gates scan the checkout, so check out that branch first (or git push --no-verify)" >&2
    status=1
    continue
  fi
  base=""
  if [ "$remote_sha" != "$zero" ] && git rev-parse -q --verify "$remote_sha^{commit}" >/dev/null 2>&1; then
    base=$remote_sha
    echo "INFO pre-push: $local_ref -> $remote $remote_ref, scanning $(git rev-parse --short "$base")..$(git rev-parse --short "$local_sha")"
  else
    echo "INFO pre-push: $local_ref -> $remote $remote_ref, no known remote commit; scanning beyond ${GATES_BASE:-origin/main}"
  fi
  scanned=1
  if ! GATES_BASE="${base:-${GATES_BASE:-}}" python3 scripts/gates/hygiene.py; then
    status=1
  fi
done

if [ "$scanned" -eq 1 ] && [ "$status" -eq 0 ]; then
  python3 scripts/gates/lint.py || status=1
fi

if [ "$status" -ne 0 ]; then
  echo "FAIL pre-push: refused; fix the findings above, or bypass with git push --no-verify" >&2
  exit 1
fi
exit 0
