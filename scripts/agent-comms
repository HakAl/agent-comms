#!/bin/sh
set -eu

# MCP clients launch this outside a shell project context, so resolve the repo
# root from the script's own location rather than a hardcoded path.
cd "$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
# Long-lived entry points execute the pre-synced checkout environment directly.
if [ ! -x .venv/bin/python ]; then
  printf '%s\n' "agent-comms: missing .venv/bin/python in $(pwd); recover with: uv sync --extra mcp" >&2
  exit 1
fi
exec .venv/bin/python -m agent_comms.cli "$@"
