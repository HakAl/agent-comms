#!/bin/sh
set -eu

# MCP clients launch this outside a shell project context, so resolve the repo
# root from the script's own location rather than a hardcoded path.
cd "$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
# A long-lived MCP server should not run under uv for its lifetime, so this
# launcher never invokes uv: it executes the checkout's pre-synced .venv
# directly and refuses loudly when the environment is absent.
if [ ! -x .venv/bin/python ]; then
  printf '%s\n' "agent-comms-mcp: missing .venv/bin/python in $(pwd); recover with: uv sync" >&2
  exit 1
fi
if ! .venv/bin/python -c 'import mcp' >/dev/null 2>&1; then
  printf '%s\n' "agent-comms-mcp: .venv/bin/python cannot import mcp in $(pwd); recover with: uv sync" >&2
  exit 1
fi
.venv/bin/python -c 'from agent_comms.release import startup_report; import sys; print(startup_report(), file=sys.stderr)' || \
  printf '%s\n' 'agent-comms startup: release_info=unknown' >&2
exec .venv/bin/python -m agent_comms.mcp_server "$@"
